  questId: Q2
  questTitle: Anciana y Cachetoncito
  ownerInitialDialogue:
    speakerName: Anciana
    lines:
    - text: Mi cachetoncitoo, viste a mi cachetoncitoo?
      voiceOrSfx: {fileID: 0}
    - text: Me ayudas a encontrarlo? (Presiona [E] para Aceptar Mision)
      voiceOrSfx: {fileID: 0}
  petFoundDialogue:
    speakerName: Cachetoncito
    lines:
    - text: Uy loco mira que esta vieja se asusto y yo me abri, yo me parcho con
        usted.
      voiceOrSfx: {fileID: 0}
  ownerDeliveredDialogue:
    speakerName: Anciana
    lines:
    - text: Cachetoncitoo!
      voiceOrSfx: {fileID: 0}
  petDeliveredDialogue:
    speakerName: Cachetoncito
    lines:
    - text: Noooooo!
      voiceOrSfx: {fileID: 0}
