  m_Name: Q1_Madre_y_Nino
  m_EditorClassIdentifier: Assembly-CSharp::Replica.Quests.QuestData
  questId: Q1
  questTitle: Madre y Nino
  ownerInitialDialogue:
    speakerName: Madre
    lines:
    - text: Mi nino justo estaba saliendo de clase pero aun no llega.
      voiceOrSfx: {fileID: 0}
    - text: Me ayudas a buscarlo? (Presiona [E] para Aceptar Mision)
      voiceOrSfx: {fileID: 0}
  petFoundDialogue:
    speakerName: Nino
    lines:
    - text: Nos dijeron que esperemos a que nos vengan a buscar. Voy contigo?
      voiceOrSfx: {fileID: 0}
  ownerDeliveredDialogue:
    speakerName: Madre
    lines:
    - text: Gracias perrito por traer a mi hijo.
      voiceOrSfx: {fileID: 0}
  petDeliveredDialogue:
    speakerName: Nino
    lines:
    - text: Mami!
      voiceOrSfx: {fileID: 0}
