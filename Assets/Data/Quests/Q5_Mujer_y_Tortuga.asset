  m_Name: Q5_Mujer_y_Tortuga
  m_EditorClassIdentifier: Assembly-CSharp::Replica.Quests.QuestData
  questId: Q5
  questTitle: Mujer y Tortuga
  ownerInitialDialogue:
    speakerName: Mujer
    lines:
    - text: Saque a pasear a mi tortuga y ya no la veo...
      voiceOrSfx: {fileID: 0}
    - text: Me ayudas a encontrarla? (Presiona [E] para Aceptar Mision)
      voiceOrSfx: {fileID: 0}
  petFoundDialogue:
    speakerName: Tortuga
    lines:
    - text: Amigo, esa vieja me pateo y quede as. Me puedes llevar en tu lomo?
      voiceOrSfx: {fileID: 0}
  ownerDeliveredDialogue:
    speakerName: Mujer
    lines:
    - text: Mira donde estabas, tortuguita.
      voiceOrSfx: {fileID: 0}
  petDeliveredDialogue:
    speakerName: Tortuga
    lines:
    - text: Tetranutria...
      voiceOrSfx: {fileID: 0}
