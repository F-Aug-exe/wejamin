  sequenceTriggerArea: {fileID: 0}
  q6f1CrowWarning:
    speakerName: Cuervo
    lines:
    - text: Oye, perro! Encontre a tu humano al final de la avenida! Sigueme!
      voiceOrSfx: {fileID: 0}
  q6f3FalseOwner:
    speakerName: Humano Desconocido
    lines:
    - text: Que? Ese no es mi perro... sigue buscando mas adelante.
      voiceOrSfx: {fileID: 0}
  q6f4RealOwner:
    speakerName: Dueno de Toby
    lines:
    - text: Toby! Estas vivo! Ven aqu, amigo mo!
      voiceOrSfx: {fileID: 0}
  q6f5CrowEnding:
    speakerName: Cuervo
    lines:
    - text: Y as, entre las ruinas de la ciudad, cada alma perdida encontro su camino
        de vuelta a casa.
      voiceOrSfx: {fileID: 0}
